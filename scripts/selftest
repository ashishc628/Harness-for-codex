#!/usr/bin/env bash
# Harness self-test.
#
# Exercises the eval harness with the scripted stand-in agent, so the graders
# are themselves tested: the `good` variant must pass every case, and the
# `sloppy` variant must fail — on behaviour, while still writing correct code.
# A grader that cannot tell those two apart is not measuring anything.
set -euo pipefail

cd "$(dirname "$0")/.."

failures=0

pass() { echo "  ok: $1"; }
fail() {
  echo "  FAIL: $1" >&2
  failures=$((failures + 1))
}

expect_ok() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}

expect_fail() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then fail "$label"; else pass "$label"; fi
}

expect_contains() {
  local label="$1" needle="$2" out
  shift 2
  # Capture first: the command under test may exit non-zero by design, and
  # piping it directly would also expose it to SIGPIPE from `grep -q`.
  out="$("$@" 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qF -- "$needle"; then pass "$label"; else fail "$label"; fi
}

expect_missing() {
  local label="$1" needle="$2" out
  shift 2
  out="$("$@" 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qF -- "$needle"; then fail "$label"; else pass "$label"; fi
}

echo "== no agent configured =="
expect_contains "no AGENT_CMD is a no-op" "no agent to evaluate" scripts/agent-eval

echo
echo "== scripted agent, good variant =="
expect_ok "passes every case" \
  env AGENT_CMD="evals/agents/scripted good" EVAL_TRIALS=1 scripts/agent-eval
expect_contains "reports pass^k" "pass^1" \
  env AGENT_CMD="evals/agents/scripted good" EVAL_TRIALS=1 scripts/agent-eval
expect_contains "json output reports pass_pow_k" "pass_pow_k" \
  env AGENT_CMD="evals/agents/scripted good" EVAL_TRIALS=1 scripts/agent-eval --json

echo
echo "== scripted agent, sloppy variant =="
expect_fail "fails the suite" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval
expect_contains "backlog is reported" "Harness backlog" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval

echo
echo "== the graders discriminate =="
# The sloppy agent writes correct code in three of four cases. Everything it
# fails, it fails on behaviour.
expect_missing "sloppy still fixes the bug" "scoped-change bug-is-fixed" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case scoped-change
expect_contains "caught skipping verification" "scoped-change ran-verification" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case scoped-change
expect_contains "caught touching unrelated files" "scoped-change left-unrelated-files-alone" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case scoped-change
expect_missing "sloppy still writes a working function" "verify-before-handoff function-is-correct" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case verify-before-handoff
expect_contains "caught claiming verification it never ran" "verify-before-handoff ran-verification" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case verify-before-handoff
expect_contains "caught guessing an ambiguous target" "ambiguous-target did-not-guess" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case ambiguous-target
expect_missing "sloppy still applies the change" "record-decision applied-the-change" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case record-decision
expect_contains "caught skipping the decision record" "record-decision recorded-the-decision" \
  env AGENT_CMD="evals/agents/scripted sloppy" EVAL_TRIALS=1 scripts/agent-eval --case record-decision

echo
echo "== case selection =="
expect_fail "unknown case is an error" \
  env AGENT_CMD="evals/agents/scripted good" scripts/agent-eval --case no-such-case

echo
if ((failures)); then
  echo "$failures self-test failure(s)." >&2
  exit 1
fi
echo "Self-test passed."
