#!/usr/bin/env bash
# Harness self-test. Exercises scripts/surface in a scratch git repository so
# the surface contract is verified by CI without imposing surfaces on this
# repository or on repositories adopting the harness.
set -euo pipefail

cd "$(dirname "$0")/.."
ROOT="$(pwd)"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

failures=0

pass() { echo "  ok: $1"; }
fail() {
  echo "  FAIL: $1" >&2
  failures=$((failures + 1))
}

expect_ok() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}

expect_fail() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then fail "$label"; else pass "$label"; fi
}

expect_contains() {
  local label="$1" needle="$2" out
  shift 2
  # Capture first: the command under test may exit non-zero by design, and
  # piping it directly would also expose it to SIGPIPE from `grep -q`.
  out="$("$@" 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qF -- "$needle"; then pass "$label"; else fail "$label"; fi
}

mkdir -p "$work/repo/scripts"
cp "$ROOT/scripts/surface" "$work/repo/scripts/surface"
cp "$ROOT/scripts/check" "$work/repo/scripts/check"
cp "$ROOT/scripts/surface-precommit" "$work/repo/scripts/surface-precommit"
cd "$work/repo"

git init -q .
git config user.email harness@example.com
git config user.name harness

echo "== no surfaces.yml =="
expect_contains "no-config is a no-op" "declares no deploy surfaces" scripts/surface list

cat >surfaces.yml <<'YAML'
version: 1

shared:
  - "docs/"

surfaces:
  - id: website
    name: Marketing website
    paths:
      - "web/"
    deny:
      - "admin/"
    verify: "web verify"
    deploy: "web deploy"

  - id: admin
    name: Admin console
    paths:
      - "admin/"
    deny:
      - "web/"
    verify: "admin verify"
    deploy: "admin deploy"
YAML

mkdir -p web admin docs
echo one >web/index.html
echo two >admin/index.html
echo three >docs/notes.md
git add -A
git commit -qm base

echo
echo "== parsing =="
expect_contains "list shows website" "Marketing website" scripts/surface list
expect_contains "list shows admin" "Admin console" scripts/surface list
expect_contains "show prints deploy" "web deploy" scripts/surface show website
expect_contains "show prints deny" "admin/" scripts/surface show website
expect_contains "plan prints verify" "web verify" scripts/surface plan website
expect_fail "unknown surface rejected" scripts/surface show nope
expect_contains "unknown surface names known ids" "Known:" scripts/surface show nope

echo
echo "== clean tree =="
expect_ok "clean tree passes" scripts/surface check website

echo
echo "== in-surface change =="
echo changed >>web/index.html
expect_ok "web change passes website" scripts/surface check website
expect_contains "detect attributes web file" "website	web/index.html" scripts/surface detect
git checkout -- web/index.html

echo
echo "== wrong-surface change =="
echo changed >>admin/index.html
expect_fail "admin change fails website check" scripts/surface check website
expect_contains "violation names the file" "admin/index.html" scripts/surface check website
expect_contains "violation says denied" "denied by surface" scripts/surface check website
expect_ok "admin change passes admin check" scripts/surface check admin
git checkout -- admin/index.html

echo
echo "== shared and unowned paths =="
echo changed >>docs/notes.md
expect_ok "shared path allowed" scripts/surface check website
expect_contains "detect marks shared" "shared	docs/notes.md" scripts/surface detect
git checkout -- docs/notes.md

echo unowned >stray.txt
expect_fail "unowned file fails check" scripts/surface check website
expect_contains "detect marks unowned" "unowned	stray.txt" scripts/surface detect
rm stray.txt

echo
echo "== untracked new file inside surface =="
echo new >web/about.html
expect_ok "untracked in-surface file passes" scripts/surface check website
rm web/about.html

echo
echo "== integration with scripts/check =="
echo changed >>admin/index.html
expect_ok "plain check ignores surfaces" scripts/check
expect_fail "SURFACE=website check fails" env SURFACE=website scripts/check
expect_ok "SURFACE=admin check passes" env SURFACE=admin scripts/check
expect_ok "pre-commit guard skips without SURFACE" scripts/surface-precommit
expect_fail "pre-commit guard enforces SURFACE" env SURFACE=website scripts/surface-precommit
git checkout -- admin/index.html

echo
echo "== --base comparison =="
echo changed >>admin/index.html
git add -A
git commit -qm "admin change"
expect_fail "committed wrong-surface change fails against base" scripts/surface check website --base HEAD~1
expect_ok "committed change passes its own surface" scripts/surface check admin --base HEAD~1

echo
if ((failures)); then
  echo "$failures self-test failure(s)." >&2
  exit 1
fi
echo "Self-test passed."
