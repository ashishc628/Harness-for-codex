#!/usr/bin/env bash
# Deploy-surface contract for the harness.
#
# A surface is one deployable target of this repository: an app store build, a
# website, an admin console. `surfaces.yml` declares which paths each surface
# owns and which command deploys it, so the target of a task is a file in the
# repository instead of an assumption in an agent's context.
#
# Subcommands:
#   list                  print declared surfaces
#   show <id>             print one surface in detail
#   detect [--base REF]   map changed files back to surfaces
#   check <id> [--base R] fail when changes escape the surface
#   plan <id>             print the deploy and verify commands for the surface
#
# With no surfaces.yml this script is a documented no-op.
set -euo pipefail

cd "$(dirname "$0")/.."

CONFIG="${SURFACES_FILE:-surfaces.yml}"

die() {
  echo "surface: $*" >&2
  exit 1
}

no_config() {
  echo "No $CONFIG found. This repository declares no deploy surfaces."
  echo "Copy surfaces.example.yml to $CONFIG to enable surface targeting."
}

# Flatten surfaces.yml into tab-separated records:
#   S<TAB>id<TAB>field<TAB>value      scalar field of a surface
#   L<TAB>id<TAB>key<TAB>item         list item of a surface
#   G<TAB>-<TAB>shared<TAB>item       repository-wide shared path
parse() {
  awk '
    function clean(s) {
      sub(/[ \t]+#.*$/, "", s)
      gsub(/^[ \t]+|[ \t]+$/, "", s)
      if (s ~ /^".*"$/ || s ~ /^'"'"'.*'"'"'$/) s = substr(s, 2, length(s) - 2)
      return s
    }
    /^[ \t]*#/ { next }
    /^[ \t]*$/ { next }
    /^shared:[ \t]*$/ { section = "shared"; id = ""; list = ""; next }
    /^surfaces:[ \t]*$/ { section = "surfaces"; id = ""; list = ""; next }
    /^[^ \t-]/ { section = ""; id = ""; list = ""; next }

    section == "shared" && /^[ \t]*-[ \t]*/ {
      line = $0; sub(/^[ \t]*-[ \t]*/, "", line)
      v = clean(line)
      if (v != "") print "G\t-\tshared\t" v
      next
    }

    section != "surfaces" { next }

    /^[ \t]*-[ \t]*id:[ \t]*/ {
      line = $0; sub(/^[ \t]*-[ \t]*id:[ \t]*/, "", line)
      id = clean(line); list = ""
      print "S\t" id "\tid\t" id
      next
    }

    id == "" { next }

    /^[ \t]+-[ \t]*/ {
      if (list == "") next
      line = $0; sub(/^[ \t]*-[ \t]*/, "", line)
      v = clean(line)
      if (v != "") print "L\t" id "\t" list "\t" v
      next
    }

    /^[ \t]+[A-Za-z_]+:[ \t]*/ {
      line = $0
      sub(/^[ \t]+/, "", line)
      key = line; sub(/:.*$/, "", key)
      val = line; sub(/^[A-Za-z_]+:[ \t]*/, "", val)
      val = clean(val)
      if (val == "") { list = key; next }
      list = ""
      print "S\t" id "\t" key "\t" val
      next
    }
  ' "$CONFIG"
}

ids() {
  parse | awk -F'\t' '$1 == "S" && $3 == "id" { print $2 }'
}

field() {
  # field <id> <name>
  parse | awk -F'\t' -v id="$1" -v k="$2" '$1 == "S" && $2 == id && $3 == k { print $4; exit }'
}

list_of() {
  # list_of <id> <key>
  parse | awk -F'\t' -v id="$1" -v k="$2" '$1 == "L" && $2 == id && $3 == k { print $4 }'
}

shared_paths() {
  parse | awk -F'\t' '$1 == "G" { print $4 }'
}

require_id() {
  local id="$1"
  [[ -n "$id" ]] || die "a surface id is required (see: scripts/surface list)"
  ids | grep -qxF "$id" || die "unknown surface '$id'. Known: $(ids | tr '\n' ' ')"
}

# Match a path against one glob. `**` is treated as `*`, and a trailing `/`
# means "everything under this directory".
path_matches() {
  local file="$1" pattern="$2"
  pattern="${pattern//\*\*/*}"
  [[ "$pattern" == */ ]] && pattern="${pattern}*"
  # shellcheck disable=SC2053
  [[ "$file" == $pattern ]]
}

matches_any() {
  local file="$1" pattern
  shift
  for pattern in "$@"; do
    path_matches "$file" "$pattern" && return 0
  done
  return 1
}

changed_files() {
  local base="$1"
  if [[ -n "$base" ]]; then
    git diff --name-only "$base"...HEAD
    git diff --name-only "$base"
  else
    git status --porcelain --untracked-files=all |
      cut -c4- |
      sed 's/^.* -> //; s/^"//; s/"$//'
  fi | sort -u
}

# read_lines <array-name> — fill an array from stdin, one element per line.
# Written without mapfile so the script still runs on bash 3.2 (macOS default).
read_lines() {
  local __name="$1" __line
  eval "$__name=()"
  while IFS= read -r __line; do
    [[ -n "$__line" ]] || continue
    eval "$__name+=(\"\$__line\")"
  done
}

cmd_list() {
  local id
  for id in $(ids); do
    printf '%s\t%s\n' "$id" "$(field "$id" name)"
  done
}

cmd_show() {
  local id="$1"
  require_id "$id"
  echo "id:      $id"
  echo "name:    $(field "$id" name)"
  echo "deploy:  $(field "$id" deploy)"
  echo "verify:  $(field "$id" verify)"
  echo "paths:"
  list_of "$id" paths | sed 's/^/  - /'
  local deny
  deny="$(list_of "$id" deny)"
  if [[ -n "$deny" ]]; then
    echo "deny:"
    printf '%s\n' "$deny" | sed 's/^/  - /'
  fi
}

cmd_detect() {
  local base="$1" file id owners
  local shared=()
  read_lines shared < <(shared_paths)
  local seen=0
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    seen=1
    owners=""
    for id in $(ids); do
      local paths=()
      read_lines paths < <(list_of "$id" paths)
      if ((${#paths[@]})) && matches_any "$file" "${paths[@]}"; then
        owners="${owners:+$owners,}$id"
      fi
    done
    if [[ -z "$owners" ]]; then
      if ((${#shared[@]})) && matches_any "$file" "${shared[@]}"; then
        owners="shared"
      else
        owners="unowned"
      fi
    fi
    printf '%s\t%s\n' "$owners" "$file"
  done < <(changed_files "$base")
  ((seen)) || echo "No changed files."
}

cmd_check() {
  local id="$1" base="$2"
  require_id "$id"

  local paths=() deny=() shared=()
  read_lines paths < <(list_of "$id" paths)
  read_lines deny < <(list_of "$id" deny)
  read_lines shared < <(shared_paths)
  ((${#paths[@]})) || die "surface '$id' declares no paths"

  local file violations=() checked=0
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    checked=$((checked + 1))
    if ((${#deny[@]})) && matches_any "$file" "${deny[@]}"; then
      violations+=("$file (denied by surface '$id')")
      continue
    fi
    matches_any "$file" "${paths[@]}" && continue
    if ((${#shared[@]})) && matches_any "$file" "${shared[@]}"; then
      continue
    fi
    violations+=("$file (outside surface '$id')")
  done < <(changed_files "$base")

  if ((${#violations[@]})); then
    echo "Surface check failed for '$id'." >&2
    printf '  %s\n' "${violations[@]}" >&2
    echo >&2
    echo "These changes do not belong to the declared surface. Either correct the" >&2
    echo "target in the task brief or move the change to its own task." >&2
    echo "Run 'scripts/surface detect' to see which surface owns each file." >&2
    return 1
  fi

  echo "Surface check passed for '$id' ($checked changed file(s))."
}

cmd_plan() {
  local id="$1"
  require_id "$id"
  local deploy verify
  deploy="$(field "$id" deploy)"
  verify="$(field "$id" verify)"
  echo "Surface '$id' ($(field "$id" name))"
  echo
  echo "Verify before deploy:"
  echo "  ${verify:-<none declared>}"
  echo
  echo "Deploy:"
  echo "  ${deploy:-<none declared>}"
  echo
  echo "Do not run any other deploy command for this task."
}

main() {
  local sub="${1:-list}"
  shift || true

  if [[ ! -f "$CONFIG" ]]; then
    no_config
    exit 0
  fi

  local base="" args=()
  while (($#)); do
    case "$1" in
      --base)
        base="${2:-}"
        [[ -n "$base" ]] || die "--base requires a ref"
        shift 2
        ;;
      -h | --help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  case "$sub" in
    list) cmd_list ;;
    show) cmd_show "${args[0]:-}" ;;
    detect) cmd_detect "$base" ;;
    check) cmd_check "${args[0]:-}" "$base" ;;
    plan) cmd_plan "${args[0]:-}" ;;
    -h | --help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown subcommand '$sub' (list, show, detect, check, plan)" ;;
  esac
}

main "$@"
